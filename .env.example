# Copie este arquivo para .env em desenvolvimento local ou cadastre os mesmos nomes
# em Vercel > Project Settings > Environment Variables.

# Obrigatório quando usar o resolvedor padrão do Apify.
# O valor precisa incluir o prefixo "Bearer ".
INSTAGRAM_RESOLVER_TOKEN=Bearer apify_api_xxxxx

# Opcional: se não configurar, a aplicação usa o endpoint padrão do Apify.
INSTAGRAM_RESOLVER_URL=https://api.apify.com/v2/acts/apify~instagram-scraper/run-sync-get-dataset-items

# Opcional: mantenha Authorization para Apify.
INSTAGRAM_RESOLVER_AUTH_HEADER=Authorization

# Opcional: tiny é o mais leve para CPU/serverless.
WHISPER_MODEL_SIZE=tiny
